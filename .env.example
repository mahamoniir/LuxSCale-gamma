# Copy to ``.env`` and set values. Flask loads ``.env`` on startup.

# Base URL of the Flask API (used by admin dashboard and mirrored to assets/dashboard_config.json).
# On startup, Flask also writes ``remote_url`` (from ``REMOTE_URL``) so chat-with-luxSCale.html can call the deployed API first.
# If the chat page is https://, set this to the same public https API base (not http://127.0.0.1) or the browser will block local http calls (\"Failed to fetch\").
# If unset, ``LOCAL_URL`` is used, then the default below.
LUXSCALE_DASHBOARD_API_BASE=

# Public API bases (CORS: all merged with ``LUXSCALE_CORS_ORIGINS`` or the built-in default)
# LOCAL_URL: comma list OK — add your PC LAN IP so phones / other machines can use the app (e.g. http://192.168.1.5:5000)
LOCAL_URL=http://127.0.0.1:5000,http://localhost:5000
# If true (or unset), add REMOTE_URL to CORS and to ``assets/dashboard_config.json`` as ``remote_url`` (chat will try the deploy API first). If false, omit REMOTE from both so the static chat page uses ``api_base`` / local Flask.
ALLOW_REMOTE=true
REMOTE_URL=https://web-production-8d09d.up.railway.app
# Extra CORS Origins; do not set to bare ``true`` (use ALLOW_REMOTE= instead)
ALLOW_REMOTE_URL=https://shortcircuit.company,https://www.shortcircuit.company

# Local Ollama (used by analysis when ``ollama_priority`` is on in ``gemini_config.json``; chat can use the flags below)
# OLLAMA_ENABLED=true
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Chat LLM: try Ollama first, then Gemini. Also respected when ``"ollama_priority": true`` in ``gemini_config.json``.
# CHAT_OLLAMA_FIRST=true
# Optional: use only Ollama for chat, never call Gemini (empty reply if Ollama is down)
# CHAT_GEMINI_DISABLED=true
